# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/logisync"

# Signing key for Auth.js session cookies. Required in production.
# Locally, `pnpm dev` auto-generates one into `.env.local` (gitignored) if unset.
# Generate manually with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Public origin used when baking absolute URLs into printed waybill QR codes.
# Behind a reverse proxy the request origin can be an internal hostname, so set
# this to the URL users actually reach (e.g. https://logisync.example.com).
APP_URL=""

# Only needed when running `pnpm seed:admin` to create/reset the first ADMIN.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Optional. Playwright e2e base URL (default http://localhost:3000).
# BASE_URL="http://localhost:3000"
