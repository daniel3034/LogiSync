// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Choose one (also update datasource in prisma.config.ts):
  // PostgreSQL (production): provider = "postgresql"
  // SQLite (local testing): provider = "sqlite"
  provider = "postgresql"
}

// Application roles. `ADMIN` is the only role permitted past the guards in
// `proxy.ts` and `lib/auth-guard.ts`.
enum Role {
  ADMIN
  DRIVER
}

// Credentials-based account used by Auth.js. `passwordHash` never leaves the
// server: `auth.ts` compares against it and returns only id/email/name/role.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(DRIVER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

// Driver model for third-party freight drivers
model Driver {
  id            String   @id @default(cuid())
  name          String
  phone         String   @unique
  truckSize     String   // e.g., "small", "medium", "large"
  preferredCities String  // Comma-separated cities. For PostgreSQL, change to String[]
  
  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations (for future use)
  waybills      Waybill[]
  
  @@map("drivers")
}

// Waybill model for digital shipment documentation
model Waybill {
  id            String   @id @default(cuid())
  driverId      String?
  driver        Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  
  // Shipment details
  senderName    String
  senderPhone   String
  receiverName  String
  receiverPhone String
  origin        String
  destination   String
  weight        Float    // in kg
  volume        Float    // in m³
  description   String?
  
  // Financials
  clientCost    Float
  driverPayment Float
  netMargin     Float
  
  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  status        String   @default("pending") // pending, in_transit, delivered
  
  @@map("waybills")
}

model RoutePricing {
  id          String   @id @default(cuid())
  origin      String
  destination String
  multiplier  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([origin, destination], name: "route_pricing_origin_destination_key")
  @@map("route_pricing")
}
